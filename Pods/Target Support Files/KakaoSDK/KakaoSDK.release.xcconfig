CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
CONFIGURATION_BUILD_DIR = ${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDK
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/KakaoSDKCertCore/Sources/KakaoSDKCertCore" "${PODS_ROOT}/KakaoSDKFriendCore/Sources/KakaoSDKFriendCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/KakaoSDKCertCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/KakaoSDKFriendCore"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public"
OTHER_CFLAGS = $(inherited) -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKAuth/KakaoSDKAuth.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCert/KakaoSDKCert.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCommon/KakaoSDKCommon.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriend/KakaoSDKFriend.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKNavi/KakaoSDKNavi.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKShare/KakaoSDKShare.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTalk/KakaoSDKTalk.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTemplate/KakaoSDKTemplate.modulemap" -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKUser/KakaoSDKUser.modulemap"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/Alamofire/Alamofire.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKAuth/KakaoSDKAuth.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCert/KakaoSDKCert.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCommon/KakaoSDKCommon.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriend/KakaoSDKFriend.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKNavi/KakaoSDKNavi.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKShare/KakaoSDKShare.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTalk/KakaoSDKTalk.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTemplate/KakaoSDKTemplate.modulemap" -Xcc -fmodule-map-file="${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKUser/KakaoSDKUser.modulemap" -import-underlying-module -Xcc -fmodule-map-file="${SRCROOT}/${MODULEMAP_FILE}"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/KakaoSDK
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKAuth" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCert" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCertCore" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCommon" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriend" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriendCore" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKNavi" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKShare" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTalk" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTemplate" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKUser"
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
