SWIFT_INCLUDE_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Alamofire" "${PODS_CONFIGURATION_BUILD_DIR}/Firebase" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseAnalytics" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseCoreInternal" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseDatabase" "${PODS_CONFIGURATION_BUILD_DIR}/FirebaseSharedSwift" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDK" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKAuth" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCert" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCertCore" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKCommon" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriend" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKFriendCore" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKNavi" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKShare" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTalk" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKTemplate" "${PODS_CONFIGURATION_BUILD_DIR}/KakaoSDKUser"
